<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>kanban</groupId>
  <artifactId>kanban-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>clean-architecture-kanban</name>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <!-- 最上層依業務情境分（CA-10）；情境之下才分四圈（CA-1） -->
  <modules>
    <module>board-management/entities</module>
    <module>board-management/use-cases</module>
    <module>board-management/interface-adapters</module>
    <module>board-management/frameworks-drivers</module>
    <module>main</module>
    <module>architecture-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>kanban</groupId>
        <artifactId>board-management-entities</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>kanban</groupId>
        <artifactId>board-management-use-cases</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>kanban</groupId>
        <artifactId>board-management-interface-adapters</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>kanban</groupId>
        <artifactId>board-management-frameworks-drivers</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>kanban</groupId>
        <artifactId>kanban-main</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
